{
  "name": "@dsh-external/human-canvas",
  "version": "0.2.0",
  "description": "人在回路工具集：离线触达(系统通知) + human-canvas(人在画布上给粗略二维输入) + PS 驱动/人工编辑。",
  "type": "module",
  "main": "./lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./lib": "./lib/index.js",
